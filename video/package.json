{
  "name": "ashke-lyric-video",
  "version": "1.0.0",
  "private": true,
  "description": "ASHKE (Karan Aujla, Mxrci) motion-designed lyric video, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render:full": "remotion render AshkeFull ../out/ashke-full-16x9.mp4",
    "render:reel": "remotion render AshkeReel ../out/ashke-reel-9x16.mp4",
    "render:viral": "remotion render AshkeViral ../out/ashke-viral-9x16-master.mp4",
    "encode:viral": "ffmpeg -y -i ../out/ashke-viral-9x16-master.mp4 -c:v libx264 -preset slow -crf 22 -maxrate 3200k -bufsize 6400k -pix_fmt yuv420p -c:a aac -b:a 192k -movflags +faststart ../out/ashke-viral-9x16.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/layout-utils": "^4.0.534",
    "@remotion/media-utils": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@fontsource/amita": "^5.1.0",
    "@fontsource/anek-gurmukhi": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/cormorant-garamond": "5.1.0",
    "@fontsource/eczar": "^5.1.0",
    "@fontsource/ibm-plex-mono": "5.1.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "5.1.0",
    "@fontsource/khand": "^5.1.0",
    "@fontsource/laila": "^5.1.0",
    "@fontsource/martel": "^5.1.0",
    "@fontsource/rozha-one": "5.1.0",
    "@fontsource/tiro-devanagari-hindi": "5.1.0",
    "@fontsource/yatra-one": "^5.1.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
